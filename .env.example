# Database connection string.
# Default is a local SQLite file; override to use Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/repair
DATABASE_URL=sqlite:///./repair.db

# Generate a private random value for stable sessions across restarts/workers.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset/empty: a random process-local key is used for the local demo.
SESSION_SECRET=
# Set true when served exclusively over HTTPS.
SESSION_HTTPS_ONLY=false
